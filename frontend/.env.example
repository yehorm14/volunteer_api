# Leave unset in development: requests go to /api and the Vite proxy forwards them to :8000.
# VITE_API_URL=https://your-api.onrender.com

# Optional. Build with true to show "Try the sample workspace" (the API needs DEMO_PUBLIC=1).
# VITE_DEMO_ENABLED=true
