# Copy to .env (repo root) and fill in. .env is gitignored.

# Required. Signs JWTs. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Optional. Without it the two AI endpoints return 503 and everything else works.
OPENAI_API_KEY=

# Optional. Defaults to a SQLite file at backend/volunteer.db.
# DATABASE_URL=sqlite:///./volunteer.db

# Optional. Comma-separated browser origins allowed to call the API.
# Defaults to the local Vite/CRA dev servers.
# CORS_ORIGINS=http://localhost:5173

# Optional JWT settings.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
