# Copy to .env (repo root) and fill in. .env is gitignored.

# Required, at least 16 characters. The API refuses to start with the placeholder below.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Optional. Without it the two AI endpoints return 503 and everything else works.
OPENAI_API_KEY=

# Optional. Defaults to a SQLite file at backend/volunteer.db.
# DATABASE_URL=sqlite:///./volunteer.db

# Optional. Comma-separated browser origins allowed to call the API.
# Defaults to the local Vite/CRA dev servers.
# CORS_ORIGINS=http://localhost:5173

# Optional. Make the demo user a public, read-only sample workspace (visitors need no password).
# Only with DEMO_USER_EMAIL set; then DEMO_USER_PASSWORD may stay unset. See docs/DEPLOY.md.
# DEMO_PUBLIC=1

# Optional. Creates a demo user with a few sample tasks on startup (safe to repeat).
# The password must be at least 8 characters. Leave unset to disable.
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_PASSWORD=demo-password

# Optional JWT settings.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional. Per-IP limit on /auth/login and /auth/register (each route counted separately).
# Defaults: 5 requests per 60 seconds, then 429. In memory, per API process.
# AUTH_RATE_LIMIT=5
# AUTH_RATE_WINDOW_SECONDS=60

# Optional. Behind a reverse proxy set to 1 so the rate limit reads the client IP from X-Forwarded-For.
# TRUSTED_PROXY_HOPS = number of proxies in front of the API (default 1); confirm it per deployment
# (e.g. temporarily log the header). Too high lets clients spoof their IP; too low shares one bucket.
# Leave unset when the API is reachable directly: the header can be forged.
# TRUST_PROXY_HEADERS=1
# TRUSTED_PROXY_HOPS=1

# Optional. AI calls per user per UTC day, shared by both AI endpoints (default 20), then 429.
# AI_DAILY_LIMIT=20
