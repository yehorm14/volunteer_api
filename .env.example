# Copy to .env (repo root) and fill in. .env is gitignored.

# Required, at least 16 characters. The API refuses to start with the placeholder below.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Optional. Without it the two AI endpoints return 503 and everything else works.
OPENAI_API_KEY=

# Optional. Defaults to a SQLite file at backend/volunteer.db.
# DATABASE_URL=sqlite:///./volunteer.db

# Optional. Comma-separated browser origins allowed to call the API.
# Defaults to the local Vite/CRA dev servers.
# CORS_ORIGINS=http://localhost:5173

# Optional. Creates a demo user with a few sample tasks on startup (safe to repeat).
# The password must be at least 8 characters. Leave unset to disable.
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_PASSWORD=demo-password

# Optional JWT settings.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
